{
  "tasks": {
    "dev": "deno run -A scripts/ensure-hooks.ts && deno run -A scripts/build.ts && deno run -A npm:wrangler dev",
    "build": "deno run -A scripts/build.ts",
    "build:extension": "deno run -A scripts/build.ts --extension-only",
    "zip:extension": "deno run -A scripts/zip-extension.ts",
    "package:extension": "deno run -A scripts/build.ts --extension-only && deno run -A scripts/zip-extension.ts",
    "setup": "deno run -A scripts/ensure-hooks.ts && deno run -A scripts/setup.ts",
    "telegram:setup": "deno run -A scripts/telegram-setup.ts",
    "deploy": "deno task build && deno run -A npm:wrangler deploy",
    "test": "deno test -A",
    "test:cov": "rm -rf .coverage && deno test -A --coverage=.coverage",
    "coverage": "deno task test:cov && deno coverage .coverage --exclude='_test\\.(ts|tsx)$|/testing/|/vendor/|/scripts/'",
    "coverage:check": "deno task test:cov && deno coverage .coverage --exclude='_test\\.(ts|tsx)$|/testing/|/vendor/|/scripts/' --threshold=85",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "e2e": "deno run -A scripts/e2e/run.ts",
    "hooks:install": "git config core.hooksPath scripts/git-hooks"
  },
  "imports": {
    "hono": "npm:hono@^4.6.0",
    "esbuild": "npm:esbuild@^0.24.0",
    "linkedom": "npm:linkedom@^0.18.13",
    "@mozilla/readability": "npm:@mozilla/readability@^0.6.0",
    "preact": "npm:preact@^10.29.7",
    "preact/hooks": "npm:preact@^10.29.7/hooks",
    "preact/jsx-runtime": "npm:preact@^10.29.7/jsx-runtime",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@clipfeed/shared/types": "./packages/shared/src/types.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "packages/web/vendor/",
      "docs/assets/",
      "dist/",
      "node_modules/",
      ".wrangler/",
      ".wrangler-e2e/",
      "e2e/",
      "deno.lock",
      // release-please regenerates this on every release PR (see
      // release-please-config.json) — its own Markdown formatting doesn't
      // match deno fmt's, and deno fmt --check has no way to "fix and
      // leave alone", so CI failed on every release PR until this was
      // excluded.
      "CHANGELOG.md",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map"
    ]
  },
  "lint": {
    "exclude": [
      "packages/web/vendor/",
      "docs/assets/",
      "dist/",
      "node_modules/",
      ".wrangler/",
      ".wrangler-e2e/",
      "e2e/"
    ]
  },
  "allowScripts": ["npm:sharp", "npm:workerd"]
}
